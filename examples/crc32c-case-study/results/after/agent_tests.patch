@@ -102,6 +102,51 @@ TEST(CRC32CTest, Crc32cStdString) {
   EXPECT_EQ(static_cast<uint32_t>(0x113fdb5c), crc32c::Crc32c(buf));
 }
 
+#if defined(__cpp_lib_byte)
+
+// verifies: CRC-005
+TEST(CRC32CTest, Crc32cBytePointer) {
+  std::byte buf[32];
+
+  std::memset(buf, 0, sizeof(buf));
+  EXPECT_EQ(static_cast<uint32_t>(0x8a9136aa),
+            crc32c::Crc32c(buf, sizeof(buf)));
+
+  std::memset(buf, 0xff, sizeof(buf));
+  EXPECT_EQ(static_cast<uint32_t>(0x62a8ab43),
+            crc32c::Crc32c(buf, sizeof(buf)));
+
+  for (size_t i = 0; i < 32; ++i)
+    buf[i] = static_cast<std::byte>(i);
+  EXPECT_EQ(static_cast<uint32_t>(0x46dd794e),
+            crc32c::Crc32c(buf, sizeof(buf)));
+
+  for (size_t i = 0; i < 32; ++i)
+    buf[i] = static_cast<std::byte>(31 - i);
+  EXPECT_EQ(static_cast<uint32_t>(0x113fdb5c),
+            crc32c::Crc32c(buf, sizeof(buf)));
+}
+
+#endif  // defined(__cpp_lib_byte)
+
+// verifies: CRC-001, CRC-005
+TEST(CRC32CTest, Crc32cCheckValue) {
+  const std::string digits = "123456789";
+  EXPECT_EQ(static_cast<uint32_t>(0xe3069283), crc32c::Crc32c(digits));
+  EXPECT_EQ(static_cast<uint32_t>(0xe3069283),
+            crc32c::Crc32c(reinterpret_cast<const uint8_t*>(digits.data()),
+                           digits.size()));
+}
+
+// verifies: CRC-003
+TEST(CRC32CTest, EmptyInput) {
+  const uint8_t data[1] = {0x5a};
+  EXPECT_EQ(static_cast<uint32_t>(0), crc32c::Crc32c(data, 0));
+  EXPECT_EQ(static_cast<uint32_t>(0), crc32c::Crc32c(std::string()));
+  EXPECT_EQ(static_cast<uint32_t>(0x12345678),
+            crc32c::Extend(0x12345678, data, 0));
+}
